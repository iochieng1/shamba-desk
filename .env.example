# Pick one provider. All are reached through the OpenAI-compatible API.

# Local open weights (no data leaves the machine): install Ollama, then
#   ollama pull qwen2.5:7b
SHAMBA_LLM_PROVIDER=ollama
# SHAMBA_LLM_MODEL=qwen2.5:7b

# Hosted open weights (fast, needs a key):
# SHAMBA_LLM_PROVIDER=groq
# GROQ_API_KEY=...
# SHAMBA_LLM_MODEL=qwen/qwen3-32b

# SHAMBA_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=...
# SHAMBA_LLM_MODEL=qwen/qwen-2.5-72b-instruct

# Any other OpenAI-compatible endpoint:
# SHAMBA_LLM_BASE_URL=...
# SHAMBA_LLM_API_KEY=...

# Cost reporting, USD per million tokens (defaults per provider in config.py)
# SHAMBA_PRICE_IN_PER_M=0.29
# SHAMBA_PRICE_OUT_PER_M=0.59

# Officer name used at the gate prompt
# SHAMBA_OFFICER=Jane Wanjiku
